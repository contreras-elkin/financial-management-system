# Copy this file to .env and set your own values (.env is not versioned)

# PostgreSQL container (also reused by the API to connect)
POSTGRES_DB=financial_db
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=change_me

# API port published on the host machine (optional)
API_PORT=8080

# Web (frontend) port published on the host machine (optional)
WEB_PORT=3000

# Image tag deployed by docker-compose.prod.yml (only on the server), e.g. 0.1.0 or sha-3d0252f
# APP_VERSION=0.1.0
